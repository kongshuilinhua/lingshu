# Lingshu Agent custom agent platform

# Current: local API and frontend
LINGSHU_DEPLOYMENT_MODE=development
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Current: auth
JWT_SECRET=replace-with-a-long-random-secret
# Required for saving private model/tool/MCP credentials; keep this value stable.
API_KEY_ENCRYPTION_KEY=
# For Anthropic system models. Private model connections use their own saved credentials.
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
INVITE_API_ENABLED=false
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Current: primary business database. Infrastructure runs in the VM at 192.168.150.101.
# Docker Compose exposes MySQL on VM port 3306 so it does not conflict with other stacks.
DATABASE_URL=mysql+pymysql://lingshu:lingshu@192.168.150.101:3306/lingshu_agent

# Current: OpenAI-compatible model provider protocol.
# Product default should prefer user-owned compatible configs, with Qwen/DashScope as the recommended preset.
# The OPENAI_* names are legacy env names for the compatible protocol, not a requirement to use GPT.
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
# Optional compatibility alias. If OPENAI_API_KEY is empty, the backend can use this key.
DASHSCOPE_API_KEY=
OPENAI_MODEL=qwen-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
RERANK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=
HEALTH_MODEL_PROBE_ENABLED=true
HEALTH_MODEL_PROBE_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=8192

# Optional backup chat provider. Keep OPENAI_API_BASE/OPENAI_MODEL on this provider
# only when you want global fallback chat to use DeepSeek.
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Query understanding parser: native keeps the existing path; langchain uses with_structured_output.
QU_PARSER=native

# LangSmith tracing is disabled by default. Enabling it requires a LangSmith account/key;
# LangChain and LangGraph traces will be uploaded to the LangSmith cloud project.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lingshu-agent

# Disabled by default. Enable to ingest extra document types such as HTML via LangChain loaders.
INGEST_LANGCHAIN_LOADERS=false

# Local fallback for development without a model key.
LINGSHU_MOCK_LLM=false

# Current: Milvus is the production/default vector target. Local dev can use memory fallback.
LINGSHU_VECTOR_BACKEND=memory
MILVUS_URI=http://192.168.150.101:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=lingshu_chunks
MILVUS_DIMENSION=

# Current: RAG retrieval defaults. Agents and single chat turns can override part of these values.
RAG_TOP_K=4
RAG_DENSE_TOP_K=12
RAG_BM25_TOP_K=12
RAG_RRF_K=60
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_TOP_N=6
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600
RAG_REFUSE_WHEN_NO_EVIDENCE=true
# Parent expansion (small-to-big): child chunks drive precise matching/ranking, then the
# matched parent chunk's full text is fed to the LLM. Falls back to child text when absent.
RAG_PARENT_EXPANSION=true

# LangGraph self-correcting retrieval (CRAG-lite); disabled by default.
RAG_SELF_CORRECT=false
RAG_SELF_CORRECT_MAX_ROUNDS=2

# Current: no-key web search for the per-turn "联网搜索" switch and builtin_search tool.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo_html
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESPONSE_BYTES=524288
WEB_SEARCH_USER_AGENT=LingshuAgent/0.1 (+https://local.lingshu.agent)

# Current: session memory. When a conversation exceeds the window, older turns are
# compressed into an LLM summary while the most recent turns are kept verbatim.
# Summary failures degrade gracefully (the previous summary is retained).
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_MAX_CHARS=800
MEMORY_KEEP_RECENT_TURNS=3

# Current: upload limit for chat attachments and knowledge documents.
UPLOAD_MAX_BYTES=31457280

# Current: optional Redis for task state/cache. Docker Compose exposes Redis on VM port 6380.
REDIS_URL=redis://192.168.150.101:6380/0

# Production hardening:
# Set LINGSHU_DEPLOYMENT_MODE=production only after replacing JWT_SECRET,
# API_KEY_ENCRYPTION_KEY, database passwords, object-storage credentials,
# and enabling Redis + Celery + a durable vector backend such as Milvus.
CELERY_ENABLED=false

# 资源库中的 MCP 服务：远程仅接入公网 HTTPS；stdio 只能选部署者批准的模板。
# JSON 形如 {"template-id":{"name":"显示名称","command":["可执行文件","参数"],"env_keys":["TOKEN"]}}
# 默认没有 stdio 模板；自定义命令由下面的部署开关控制。
MCP_STDIO_TEMPLATES_JSON={}
# 允许受信任管理员从网页配置后端本机的启动程序，默认关闭。
MCP_ALLOW_CUSTOM_STDIO=false
# Skill 脚本仅在该已安装的 Docker 镜像中运行，不自动拉取镜像；空值禁用脚本执行。
SKILL_SANDBOX_IMAGE=
# 生产 OAuth 需配置可公开访问的精确回调地址；development 未填写时使用 http://127.0.0.1:8000/api/mcp/oauth/callback。
MCP_OAUTH_REDIRECT_URL=
# 可选：公开托管的 Client ID Metadata Document 地址；未设置时 SDK 使用兼容注册流程。
MCP_CLIENT_METADATA_URL=
